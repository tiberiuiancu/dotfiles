# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# On non-standard zsh installations (e.g. compute clusters), the zsh functions
# directory may not be in $fpath, causing compinit/add-zsh-hook/etc to fail.
# Add user-local and system zsh function dirs if not already present.
for _zsh_fn_dir in \
    ~/.local/share/zsh/*/functions(N) \
    /usr/local/share/zsh/*/functions(N) \
    /usr/share/zsh/*/functions(N); do
    [[ -z "${fpath[(r)$_zsh_fn_dir]}" ]] && fpath=("$_zsh_fn_dir" $fpath)
done
unset _zsh_fn_dir

ZSH_THEME="robbyrussell"

plugins=(git zsh-syntax-highlighting zsh-autosuggestions)

# Store compdump on local disk (avoids slowness on network filesystems like GPFS)
ZSH_COMPDUMP="${TMPDIR:-/tmp}/zcompdump-${USER}-${ZSH_VERSION}"
ZSH_DISABLE_COMPFIX=true

# Intercept compinit to use -C (skip stale-check and rescan; use cached dump)
# First shell start is slow (builds cache), subsequent ones are fast.
compinit() {
    unfunction compinit
    autoload -Uz compinit
    compinit -C -d "${ZSH_COMPDUMP}"
}

source $ZSH/oh-my-zsh.sh

# ALIASES
alias vim="nvim"
alias vi="nvim"
alias ca="conda activate"
alias cad="conda deactivate"
alias jn="conda run -v -n base jupyter notebook"
alias doc="docker compose"

# Rust
export PATH="$PATH:$HOME/.cargo/bin"

# nvm
export NVM_DIR="$HOME/.nvm"
# Lazy-load nvm — only initialize when node/npm/nvm is first used
_load_nvm() {
    unset -f nvm node npm npx
{{ if eq .chezmoi.os "darwin" -}}
    [ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
    [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
{{ else -}}
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
{{ end -}}
}
nvm() { _load_nvm; nvm "$@" }
node() { _load_nvm; node "$@" }
npm() { _load_nvm; npm "$@" }
npx() { _load_nvm; npx "$@" }

export NODE_OPTIONS=--openssl-legacy-provider

# Auto-attach to tmux (not on remote SSH sessions)
if command -v tmux &>/dev/null && [ -z "$TMUX" ] && [ -z "$SSH_CONNECTION" ]; then
    tmux attach-session -t default 2>/dev/null || tmux new-session -s default
fi
